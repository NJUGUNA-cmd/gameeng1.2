{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-Command",
                "cmake '${workspaceFolder}' ; if ($?) { cmake --build . }"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Game",
            "type": "shell",
            "command": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/C",
                "C:\\Users\\IAN\\source\\repos\\gameeng1.2\\build\\gameeng.exe"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": true,
                "focus": true
            }
        }
    ]
}


